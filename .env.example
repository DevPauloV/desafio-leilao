# Copie para .env: cp .env.example .env
# Troque o JWT_SECRET (ex.: openssl rand -hex 32). Nunca versione o .env.

# Portas expostas na máquina
API_PORT=3000
FRONT_PORT=8080

# URL da API como o navegador a enxerga (usada no build do front)
VITE_API_URL=http://localhost:3000

# MongoDB em replica set (necessário para transações). Usado ao rodar sem Docker;
# no Docker Compose o valor é definido pelo próprio compose.
MONGO_URI=mongodb://localhost:27017/athelie-leiloes?replicaSet=rs0

# Origens permitidas no CORS, separadas por vírgula (front no Docker e front em desenvolvimento)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Autenticação
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=1d

# Chave das assinaturas HMAC da auditoria e dos pseudônimos (ex.: openssl rand -hex 32).
# Se mudar depois que houver lances, a auditoria passa a acusar adulteração em tudo.
AUDIT_SECRET=troque-este-segredo-de-auditoria

# Proxies reversos na frente da API: 0 no Docker e local; 1 no Railway (o rate limit usa o IP real)
TRUST_PROXY=0

# Popula leiloeiro, 2 clientes e um lote ao vivo com lances (idempotente)
SEED_ON_START=true

# The Met Collection API (sem chave)
MET_API_BASE=https://collectionapi.metmuseum.org/public/collection/v1
